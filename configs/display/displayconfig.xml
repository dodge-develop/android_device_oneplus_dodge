            <nits>464.013153</nits>
        </point>
        <point>
            <value>0.858573522</value> <!-- level 3515 (panel HBM cmds latch above here) -->
            <nits>570.474060</nits>
        </point>
        <point>
            <value>0.903761602</value> <!-- level 3700 -->
            <nits>638.622314</nits>
        </point>
