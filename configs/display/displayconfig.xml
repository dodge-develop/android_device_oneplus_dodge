<?xml version="1.0" encoding="UTF-8"?>
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2376</height>
            <width>1080</width>
            <density>450</density>
        </density>
        <density default="true">
            <height>3168</height>
            <width>1440</width>
            <density>560</density>
        </density>
    </densityMapping>

    <!-- Framework brightness float maps linearly onto the panel backlight level
         (float = level / 4094; QC HWC scales by qcom,mdss-brightness-max-level and
         the oplus driver passes the level through untouched: global-hbm-case-id 1
         only latches the panel HBM enter/exit cmds when crossing level 3515).
         Nits are the full-white values from the stock OOS factory calibration
         table for this panel (dodge_imgs my_product/vendor/etc/
         display_brightness_config_P_3.xml, panel "AA569 P 3 A0019"). -->
    <screenBrightnessMap>
        <point>
            <value>0.000244260</value> <!-- level 1 -->
            <nits>1.976413</nits>
        </point>
        <point>
            <value>0.001465559</value> <!-- level 6 (stock table min) -->
            <nits>2.000237</nits>
        </point>
        <point>
            <value>0.002442599</value> <!-- level 10 -->
            <nits>2.024348</nits>
        </point>
        <point>
            <value>0.012212995</value> <!-- level 50 -->
            <nits>2.282038</nits>
        </point>
        <point>
            <value>0.024425989</value> <!-- level 100 -->
            <nits>2.650758</nits>
        </point>
        <point>
            <value>0.048851979</value> <!-- level 200 -->
            <nits>3.576549</nits>
        </point>
        <point>
            <value>0.073277968</value> <!-- level 300 -->
            <nits>4.825680</nits>
        </point>
        <point>
            <value>0.097703957</value> <!-- level 400 -->
            <nits>6.511074</nits>
        </point>
        <point>
            <value>0.146555936</value> <!-- level 600 -->
            <nits>11.853360</nits>
        </point>
        <point>
            <value>0.195407914</value> <!-- level 800 -->
            <nits>21.978460</nits>
        </point>
        <point>
            <value>0.244259893</value> <!-- level 1000 -->
            <nits>35.908691</nits>
        </point>
        <point>
            <value>0.293111871</value> <!-- level 1200 -->
            <nits>53.628906</nits>
        </point>
        <point>
            <value>0.350024426</value> <!-- level 1433 (stock default) -->
            <nits>79.239517</nits>
        </point>
        <point>
            <value>0.415241817</value> <!-- level 1700 -->
            <nits>115.395455</nits>
        </point>
        <point>
            <value>0.488519785</value> <!-- level 2000 -->
            <nits>164.993256</nits>
        </point>
        <point>
            <value>0.561797753</value> <!-- level 2300 -->
            <nits>224.389420</nits>
        </point>
        <point>
            <value>0.635075721</value> <!-- level 2600 -->
            <nits>293.860748</nits>
        </point>
        <point>
            <value>0.708353688</value> <!-- level 2900 -->
            <nits>373.659302</nits>
        </point>
        <point>
            <value>0.781631656</value> <!-- level 3200 -->
            <nits>464.013153</nits>
        </point>
        <point>
            <value>0.858573522</value> <!-- level 3515 (panel HBM cmds latch above here) -->
            <nits>570.474060</nits>
        </point>
        <point>
            <value>0.903761602</value> <!-- level 3700 -->
            <nits>638.622314</nits>
        </point>
        <point>
            <value>0.952613581</value> <!-- level 3900 -->
            <nits>717.038452</nits>
        </point>
        <point>
            <value>0.977039570</value> <!-- level 4000 -->
            <nits>758.109924</nits>
        </point>
        <point>
            <value>1.000000000</value> <!-- level 4094 (kernel bl-max) -->
            <nits>797.857666</nits>
        </point>
    </screenBrightnessMap>

    <!-- Quick to brighten, lazy to darken, like stock OOS. These override the
         config_autoBrightness*LightDebounce overlay values. 4000 held the panel
         visibly stuck at a level before it would even begin dimming; 2000 still
         rides out momentary shadows (a hand passing, a dark video frame) but
         starts the ramp while the change still feels tied to the room. -->
    <autoBrightness enabled="True">
        <brighteningLightDebounceMillis>1000</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>2000</darkeningLightDebounceMillis>
    </autoBrightness>

    <!-- Kept disabled: the enabled block's 5min/30min budget dimmed the panel in
         the sun, and >800 nits is driven by hbm_max. Present only so the framework
         still publishes an HDR/SDR ratio, which keeps the HDR brightness setting
         and HDR detection alive. -->
    <highBrightnessMode enabled="false">
        <transitionPoint>0.85</transitionPoint>
        <minimumLux>10000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <minimumHdrPercentOfScreen>0.2</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>6.0</hdrRatio>
            </point>
            <point>
                <sdrNits>25.0</sdrNits>
                <hdrRatio>5.0</hdrRatio>
            </point>
            <point>
                <sdrNits>50.0</sdrNits>
                <hdrRatio>4.0</hdrRatio>
            </point>
            <point>
                <sdrNits>100.0</sdrNits>
                <hdrRatio>3.0</hdrRatio>
            </point>
            <point>
                <sdrNits>200.0</sdrNits>
                <hdrRatio>2.4</hdrRatio>
            </point>
            <point>
                <sdrNits>300.0</sdrNits>
                <hdrRatio>2.0</hdrRatio>
            </point>
            <point>
                <sdrNits>400.0</sdrNits>
                <hdrRatio>1.7</hdrRatio>
            </point>
            <point>
                <sdrNits>500.0</sdrNits>
                <hdrRatio>1.5</hdrRatio>
            </point>
            <point>
                <sdrNits>600.0</sdrNits>
                <hdrRatio>1.3</hdrRatio>
            </point>
            <point>
                <sdrNits>798.0</sdrNits>
                <hdrRatio>1.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <!-- HDR boost: HdrBrightnessModifier reads this block directly and, with no
         enabled HBM block, boosts up to BRIGHTNESS_MAX (the 798-nit backlight
         ceiling). SF dims SDR layers by the same ratio, so SDR content stays at
         the user's level while HDR highlights get the headroom. brightnessMap keys
         are ambient-lux upper bounds: the cap applies below the key, so HDR can't
         blind in a dark room. -->
    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>10</first>
                <second>0.708354</second> <!-- below 10 lux cap HDR at ~374 nits -->
            </point>
            <point>
                <first>100</first>
                <second>0.858574</second> <!-- below 100 lux cap HDR at ~570 nits -->
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>1000</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>3000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.15</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.06</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0.2</minimumHdrPercentOfScreenForNbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <!-- first = SDR nits, second = HDR/SDR boost ratio. Ratios chosen so
             ratio * sdrNits stays within the 798-nit full-white ceiling and
             tapers to 1.0 at the top. -->
        <sdrHdrRatioMap>
            <point>
                <first>2</first>
                <second>6.0</second>
            </point>
            <point>
                <first>25</first>
                <second>5.0</second>
            </point>
            <point>
                <first>50</first>
                <second>4.0</second>
            </point>
            <point>
                <first>100</first>
                <second>3.0</second>
            </point>
            <point>
                <first>200</first>
                <second>2.4</second>
            </point>
            <point>
                <first>300</first>
                <second>2.0</second>
            </point>
            <point>
                <first>400</first>
                <second>1.7</second>
            </point>
            <point>
                <first>500</first>
                <second>1.5</second>
            </point>
            <point>
                <first>600</first>
                <second>1.3</second>
            </point>
            <point>
                <first>798</first>
                <second>1.0</second>
            </point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>

    <screenBrightnessRampFastDecrease>0.5</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.5</screenBrightnessRampFastIncrease>
    <!-- Downward rate was never tuned alongside the upward one: 0.04/s is ~25s
         for a full-range dim, which reads as "stuck at max" rather than a slow
         fade. 0.10/s (~10s full range) keeps dimming gentler than brightening
         without stalling. -->
    <screenBrightnessRampSlowDecrease>0.10</screenBrightnessRampSlowDecrease>
    <!-- Auto-brightness animates upward at the slow rate: 0.05 took ~14s for a
         dark-room to sunlight swing; 0.25 reaches it in ~3s, close to stock. -->
    <screenBrightnessRampSlowIncrease>0.25</screenBrightnessRampSlowIncrease>
    <!-- Hard ceilings on ramp duration so a large swing can never crawl: with
         only a rate set, the time to target scales with the size of the jump.
         Order matters (xsd sequence): Increase before Decrease. -->
    <screenBrightnessRampIncreaseMaxMillis>3000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>4000</screenBrightnessRampDecreaseMaxMillis>
</displayConfiguration>
