<?xml version="1.0" encoding="UTF-8"?>
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2376</height>
            <width>1080</width>
            <density>450</density>
        </density>
        <density default="true">
            <height>3168</height>
            <width>1440</width>
            <density>560</density>
        </density>
    </densityMapping>

    <!-- Framework brightness float maps linearly onto the panel backlight level
         (float = level / 4094; QC HWC scales by qcom,mdss-brightness-max-level and
         the oplus driver passes the level through untouched: global-hbm-case-id 1
         only latches the panel HBM enter/exit cmds when crossing level 3515).
         Nits are the full-white values from the stock OOS factory calibration
         table for this panel (dodge_imgs my_product/vendor/etc/
         display_brightness_config_P_3.xml, panel "AA569 P 3 A0019"). -->
    <screenBrightnessMap>
        <point>
            <value>0.000244260</value> <!-- level 1 -->
            <nits>1.976413</nits>
        </point>
        <point>
            <value>0.001465559</value> <!-- level 6 (stock table min) -->
            <nits>2.000237</nits>
        </point>
        <point>
            <value>0.002442599</value> <!-- level 10 -->
            <nits>2.024348</nits>
        </point>
        <point>
            <value>0.012212995</value> <!-- level 50 -->
            <nits>2.282038</nits>
        </point>
        <point>
            <value>0.024425989</value> <!-- level 100 -->
            <nits>2.650758</nits>
        </point>
        <point>
            <value>0.048851979</value> <!-- level 200 -->
            <nits>3.576549</nits>
        </point>
        <point>
            <value>0.073277968</value> <!-- level 300 -->
            <nits>4.825680</nits>
        </point>
        <point>
            <value>0.097703957</value> <!-- level 400 -->
            <nits>6.511074</nits>
        </point>
        <point>
            <value>0.146555936</value> <!-- level 600 -->
            <nits>11.853360</nits>
        </point>
        <point>
            <value>0.195407914</value> <!-- level 800 -->
            <nits>21.978460</nits>
        </point>
        <point>
            <value>0.244259893</value> <!-- level 1000 -->
            <nits>35.908691</nits>
        </point>
        <point>
            <value>0.293111871</value> <!-- level 1200 -->
            <nits>53.628906</nits>
        </point>
        <point>
            <value>0.350024426</value> <!-- level 1433 (stock default) -->
            <nits>79.239517</nits>
        </point>
        <point>
            <value>0.415241817</value> <!-- level 1700 -->
            <nits>115.395455</nits>
        </point>
        <point>
            <value>0.488519785</value> <!-- level 2000 -->
            <nits>164.993256</nits>
        </point>
        <point>
            <value>0.561797753</value> <!-- level 2300 -->
            <nits>224.389420</nits>
        </point>
        <point>
            <value>0.635075721</value> <!-- level 2600 -->
            <nits>293.860748</nits>
        </point>
        <point>
            <value>0.708353688</value> <!-- level 2900 -->
