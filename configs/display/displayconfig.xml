            <value>1.000000000</value> <!-- level 4094 (kernel bl-max) -->
            <nits>797.857666</nits>
        </point>
    </screenBrightnessMap>

    <!-- Quick to brighten, lazy to darken, like stock OOS. These override the
         config_autoBrightness*LightDebounce overlay values. -->
    <autoBrightness enabled="True">
        <brighteningLightDebounceMillis>1000</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>4000</darkeningLightDebounceMillis>
    </autoBrightness>

    <!-- No highBrightnessMode block: the whole float range is the panel's normal
         backlight range (max level 4094 = ~798 nits full-white, matching the stock
         slider ceiling). The old block put everything above 0.85 on a 5min/30min
         HBM budget, which dimmed the screen back down after a few minutes in the
         sun. The panel's real >800-nit region (stock table rows 4096-4674, up to
         1576 nits) is only reachable through the oplus HBM interface (hbm_max),
         not the backlight path - the kernel clamps backlight at 4094. -->

    <!-- HDR boost without highBrightnessMode: HdrBrightnessModifier reads this
         block directly and, with no HBM block, boosts up to BRIGHTNESS_MAX (the
         798-nit backlight ceiling). SF dims SDR layers by the same ratio, so
         SDR content stays at the user's level while HDR highlights get the
         headroom. brightnessMap keys are ambient-lux upper bounds: the cap
         applies below the key, so HDR can't blind in a dark room. -->
    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>10</first>
                <second>0.708354</second> <!-- below 10 lux cap HDR at ~374 nits -->
            </point>
            <point>
                <first>100</first>
                <second>0.858574</second> <!-- below 100 lux cap HDR at ~570 nits -->
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>1000</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>3000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.15</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.06</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0.2</minimumHdrPercentOfScreenForNbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <!-- first = SDR nits, second = HDR/SDR boost ratio. Ratios chosen so
             ratio * sdrNits stays within the 798-nit full-white ceiling and
             tapers to 1.0 at the top. -->
        <sdrHdrRatioMap>
            <point>
                <first>2</first>
                <second>6.0</second>
            </point>
            <point>
                <first>25</first>
                <second>5.0</second>
            </point>
            <point>
                <first>50</first>
                <second>4.0</second>
            </point>
            <point>
                <first>100</first>
                <second>3.0</second>
            </point>
            <point>
                <first>200</first>
                <second>2.4</second>
            </point>
            <point>
                <first>300</first>
                <second>2.0</second>
            </point>
            <point>
                <first>400</first>
                <second>1.7</second>
            </point>
            <point>
                <first>500</first>
                <second>1.5</second>
            </point>
            <point>
                <first>600</first>
                <second>1.3</second>
            </point>
            <point>
                <first>798</first>
                <second>1.0</second>
            </point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>

    <screenBrightnessRampFastDecrease>0.5</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.5</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.04</screenBrightnessRampSlowDecrease>
    <!-- Auto-brightness animates upward at the slow rate: 0.05 took ~14s for a
         dark-room to sunlight swing; 0.25 reaches it in ~3s, close to stock. -->
    <screenBrightnessRampSlowIncrease>0.25</screenBrightnessRampSlowIncrease>
</displayConfiguration>
