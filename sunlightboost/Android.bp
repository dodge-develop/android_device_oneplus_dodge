// SPDX-License-Identifier: Apache-2.0
//
// Standalone automatic sunlight boost for OnePlus dodge (AA569 panel).
// Hosts SunlightBoostController without the full OnePlus Settings app.

android_app {
    name: "SunlightBoost",

    // Listed explicitly rather than globbed: soong caches glob results and does
    // not re-glob newly added files on an incremental build, which silently
    // drops them from the APK (hit exactly this with SunlightBoostApp.java).
    srcs: [
        "src/org/lineageos/device/sunlightboost/BootReceiver.java",
        "src/org/lineageos/device/sunlightboost/Constants.java",
        "src/org/lineageos/device/sunlightboost/FileUtils.java",
        "src/org/lineageos/device/sunlightboost/HbmController.java",
        "src/org/lineageos/device/sunlightboost/PwmController.java",
        "src/org/lineageos/device/sunlightboost/SunlightBoostApp.java",
        "src/org/lineageos/device/sunlightboost/SunlightBoostController.java",
        "src/org/lineageos/device/sunlightboost/SunlightBoostService.java",
    ],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    privapp_allowlist: "privapp-permissions-sunlightboost.xml",

    optimize: {
        enabled: false,
    },
}
